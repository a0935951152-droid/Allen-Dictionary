# ── 收斂式字典 — 封閉建構環境變數 ───────────────────────────────
# 複製成 .env 後依機器調整。模型服務全離線、無對外路由（internal 網路）。

# 本地模型根目錄（唯讀掛載進各容器）
MODELS_ROOT=/nas-data/allen/models

# 判官 LLM（vLLM）— 本地路徑，不經 hub
JUDGE_MODEL_DIR=breeze-7b-w4a16-awq          # W4A16 / Ampere 友善（無 FP8）

# 嵌入 / 重排（TEI）— 直接指向本地 snapshot，徹底不連網
# （路徑 = tei-cache 內 models--<repo>/snapshots/<refs/main 的 hash>）
EMBED_MODEL_PATH=/data/models--BAAI--bge-m3/snapshots/5617a9f61b028005a4858fdac845db406aefb181
RERANK_MODEL_PATH=/data/models--BAAI--bge-reranker-v2-m3/snapshots/953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e

# NER（§3 便宜濾網）— ckip，由 ${MODELS_ROOT}:/models 掛載
NER_MODEL_PATH=/models/ner/ckip-bert-base-chinese-ner

# GPU 顯存配比（單卡 RTX 3090 Ti 24GB；judge≈11G + 兩個 TEI≈3-4G）
VLLM_GPU_FRACTION=0.45
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=16

# 對外埠（只有 api 對 host 公開；模型服務不公開）
API_PORT=8080

# 收斂引擎建議閾值（§3；先當上色/提示用，非自動停機）
CONVERGE_N=3      # 連續 N 輪不變 → 穩定
CONVERGE_M=6      # 跑滿 M 輪仍跳 → 搖擺
CONVERGE_K=2      # 在 ≥K 個寫法間跳算搖擺
RRF_K=60          # Reciprocal Rank Fusion 常數
GROUNDING_THRESHOLD=0.5   # RRF 分數 ≥ 此值視為接地通過

# ── Cloudflare 臨時通道（dev/demo 用；正式版進自己網域）──────────
# 留空 = 用 TryCloudflare 快速通道（隨機 *.trycloudflare.com，免帳號）。
# 正式：填入 named tunnel token，並在 Cloudflare 後台綁自己的網域。
CLOUDFLARE_TUNNEL_TOKEN=

# ── 判定側守門（2026-07-02 結構審查 A1/A3/A5）────────────────────
COMMON_FPM=10     # 通用詞門檻（jieba 詞頻，每百萬詞次數）：≥此值的詞永不 auto 改、不進無條件變體/regex
# 判定側管線參數（不填用預設；前端「⚙ 參數」站可檢視實際生效值）
IPA_FUZZY=0.28          # CAG 音近召回上限（IPA 加權編輯距離）
IPA_EXACT=0.0           # 字典/refterms 真同音門檻
IPA_SUB_CONFUSE=0.34    # 混淆類音素替換代價（送氣/捲舌/前後鼻音）
IPA_SUB_TONE=0.30       # 聲調 token 代價（含調全同=0 才算真同音）
LOCAL_FLOOR=0.35        # 局部語意命中門檻（局部句→心智圖餘弦）
WIKI_FLOOR=0.55         # 語意錨點 wiki 橋接下限
LOCAL_TOPK=5            # 局部語意排名制取前 k
JUDGE_CONCURRENCY=4     # gemma 判官併發
